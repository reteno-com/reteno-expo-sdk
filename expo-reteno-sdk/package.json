{
  "name": "expo-reteno-sdk",
  "version": "2.5.4",
  "description": "Expo wrapper for Reteno SDK",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "lint": "expo-module lint",
    "test": "expo-module test",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly && expo-module clean plugin && EXPO_NONINTERACTIVE=1 expo-module build plugin",
    "expo-module": "expo-module",
    "open:ios": "xed example/ios",
    "open:android": "open -a \"Android Studio\" example/android",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test:plugin": "EXPO_NONINTERACTIVE=1 expo-module build plugin && node --test plugin/__tests__/*.test.js",
    "build:all": "EXPO_NONINTERACTIVE=1 expo-module build && EXPO_NONINTERACTIVE=1 expo-module build plugin"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-reteno-sdk",
    "ExpoRetenoSdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/reteno-com/reteno-expo-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/reteno-com/reteno-expo-sdk/issues"
  },
  "author": "mobile-sdk@reteno.com",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/reteno-com/reteno-expo-sdk#readme",
  "devDependencies": {
    "expo": "~58.0.26",
    "expo-module-scripts": "^56.0.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "@types/node": "^22.14.0",
    "@types/react": "~19.3.0",
    "typescript": "~5.9.3"
  },
  "files": [
    "build",
    "android/build.gradle",
    "android/src",
    "ios",
    "plugin/build",
    "plugin/src/support/nse",
    "plugin/src/support/nce",
    "app.plugin.js",
    "expo-module.config.json",
    "docs"
  ],
  "plugins": "./app.plugin.js",
  "peerDependencies": {
    "expo": ">=54.0.0 <59.0.0",
    "react": "*",
    "react-native": "*"
  }
}
