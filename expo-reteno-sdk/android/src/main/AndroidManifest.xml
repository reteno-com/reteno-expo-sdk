<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
  <application>
    <provider
      android:name="expo.modules.retenosdk.RetenoNotificationGroupingRuleProvider"
      android:authorities="${applicationId}.reteno.notification-grouping-rule"
      android:exported="false" />

    <service
      android:name="expo.modules.retenosdk.RetenoMessagingService"
      android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>

    <receiver
      android:name="expo.modules.retenosdk.RetenoCustomReceiverInAppData"
      android:enabled="true"
      android:exported="false">
      <intent-filter>
        <action android:name="com.reteno.custom-inapp-data" />
      </intent-filter>
    </receiver>

    <!-- Remove the base-class service so only our subclass handles FCM messages. -->
    <service
      android:name="com.reteno.fcm.RetenoFirebaseMessagingService"
      tools:node="remove" />
  </application>
</manifest>
